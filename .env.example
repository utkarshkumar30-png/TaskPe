# Copy to .env or configure these variables in the process environment.
# Never commit real values.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-production-secret
PAYOUT_MODE=MANUAL
# Set to 1 only when exactly one trusted local HTTPS reverse proxy fronts Waitress.
TRUSTED_PROXY_HOPS=0
# Set to 1 only after HTTPS is enforced by the reverse proxy.
ENABLE_HSTS=0
SMS_PROVIDER=disabled
FAST2SMS_ENABLED=0
FAST2SMS_API_KEY=replace-with-fast2sms-api-key
FAST2SMS_ROUTE=q
EMAIL_PROVIDER=disabled
# Required in production; use absolute paths outside the checkout.
TASKPE_DB_PATH=<absolute-persistent-data-directory>\taskpe.db
TASKPE_UPLOAD_FOLDER=<absolute-persistent-data-directory>\uploads\proofs
TASKPE_TASK_ASSET_FOLDER=<absolute-persistent-data-directory>\uploads\task-assets
# Set to brevo to enable email-only signup OTP delivery through Brevo HTTPS.
# Required only when EMAIL_PROVIDER=brevo.
# BREVO_API_KEY=replace-with-brevo-api-key
# EMAIL_FROM=support@mytaskpe.com
# EMAIL_FROM_NAME=TaskPe
# TASKPE_ADMIN_EMAIL=admin@example.com
# TASKPE_ADMIN_PASSWORD=replace-with-a-long-random-password
# TASKPE_ADMIN_MOBILE=919999999999
# Stage 1 WhatsApp linked-device service & automated campaign dispatch.
# Disabled by default; set to 1 to enable.
TASKPE_WHATSAPP_LINKED_DEVICE_ENABLED=0
TASKPE_WHATSAPP_CONSENT_GATE_ENABLED=0
TASKPE_WA_CAMPAIGN_BATCH_HTTP_SEND_ENABLED=0
TASKPE_WA_CTA_BUTTON_LABEL=Shop Now
TASKPE_WA_DAILY_QUOTA_LIMIT=80
TASKPE_WA_SERVICE_URL=http://127.0.0.1:8765
TASKPE_WA_SERVICE_PORT=8765
# Generate a random 32+ character value locally; never commit a real value.
TASKPE_WA_SERVICE_SHARED_SECRET=replace-with-a-random-32-plus-character-local-secret
# Prefer an absolute private path outside the repository.
TASKPE_WA_SESSION_DIR=<absolute-private-local-directory>\taskpe-wa-sessions
TASKPE_WA_SERVICE_TIMEOUT_SECONDS=8
