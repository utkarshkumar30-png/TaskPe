[Unit]
Description=TaskPe Flask Web Application Service
After=network.target

[Service]
Type=simple
User=taskpe
Group=taskpe
WorkingDirectory=/home/taskpe/app
EnvironmentFile=/home/taskpe/app/.env
ExecStart=/home/taskpe/app/.venv/bin/waitress-serve --listen=127.0.0.1:5000 --threads=4 wsgi:app
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
