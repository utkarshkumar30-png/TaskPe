[Unit]
Description=TaskPe WhatsApp Microservice (Node.js & Baileys)
After=network.target

[Service]
Type=simple
User=taskpe
Group=taskpe
WorkingDirectory=/home/taskpe/app
EnvironmentFile=/home/taskpe/app/.env
ExecStart=/usr/bin/node /home/taskpe/app/server.js
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
